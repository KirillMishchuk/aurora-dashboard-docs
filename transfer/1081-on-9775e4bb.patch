diff --git a/packages/aurora/src/server/Storage/helpers/s3ErrorMapper.test.ts b/packages/aurora/src/server/Storage/helpers/s3ErrorMapper.test.ts
index b82f4437..5b36495e 100644
--- a/packages/aurora/src/server/Storage/helpers/s3ErrorMapper.test.ts
+++ b/packages/aurora/src/server/Storage/helpers/s3ErrorMapper.test.ts
@@ -26,6 +26,25 @@ describe("mapS3ErrorToTRPCError", () => {
       )
     })
 
+    // HEAD responses carry no XML body, so there is no `Code` for the SDK to read and it
+    // falls back to a status-derived `name`. Without these two rows a HeadBucket miss would
+    // map to INTERNAL_SERVER_ERROR and callers could not act on it.
+    it("maps the bodiless NotFound (HEAD) to NOT_FOUND", () => {
+      const error = Object.assign(new Error("NotFound"), { name: "NotFound" })
+
+      expect(() => mapS3ErrorToTRPCError(error, { operation: TEST_OPERATION, bucket: TEST_BUCKET })).toThrow(
+        expect.objectContaining({ code: "NOT_FOUND" })
+      )
+    })
+
+    it("maps the bodiless Forbidden (HEAD) to FORBIDDEN", () => {
+      const error = Object.assign(new Error("Forbidden"), { name: "Forbidden" })
+
+      expect(() => mapS3ErrorToTRPCError(error, { operation: TEST_OPERATION, bucket: TEST_BUCKET })).toThrow(
+        expect.objectContaining({ code: "FORBIDDEN" })
+      )
+    })
+
     it("maps NoSuchKey to NOT_FOUND", () => {
       const error = Object.assign(new Error("The specified key does not exist"), { Code: "NoSuchKey" })
 
diff --git a/packages/aurora/src/server/Storage/helpers/s3ErrorMapper.ts b/packages/aurora/src/server/Storage/helpers/s3ErrorMapper.ts
index b0092ff6..3b4a759a 100644
--- a/packages/aurora/src/server/Storage/helpers/s3ErrorMapper.ts
+++ b/packages/aurora/src/server/Storage/helpers/s3ErrorMapper.ts
@@ -8,6 +8,12 @@ interface S3ErrorShape {
 }
 
 const S3_ERROR_MAP: Record<string, TRPCError["code"]> = {
+  // HEAD requests carry no XML body, so the SDK has no `Code` to read and falls back to
+  // these bare status-derived names. HeadBucket on a missing bucket therefore surfaces as
+  // `NotFound`, never as `NoSuchBucket` — without this row it would map to a 500 and the
+  // caller could not tell "no such bucket" from "the request blew up".
+  NotFound: "NOT_FOUND",
+  Forbidden: "FORBIDDEN",
   NoSuchBucket: "NOT_FOUND",
   NoSuchKey: "NOT_FOUND",
   NoSuchUpload: "NOT_FOUND",
