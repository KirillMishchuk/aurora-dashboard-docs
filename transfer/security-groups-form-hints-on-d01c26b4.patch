diff --git a/packages/aurora/src/client/routes/_auth/projects/$projectId/network/securitygroups/-components/-modals/securityGroupValidation.ts b/packages/aurora/src/client/routes/_auth/projects/$projectId/network/securitygroups/-components/-modals/securityGroupValidation.ts
new file mode 100644
